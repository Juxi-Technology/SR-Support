<mujoco model="sr_2dof">
  <!--
    Independent 2-DOF self-righting model for SR-Support.
    This file is NOT copied from SelfRisingRobot or any other project.
    Dimensions/masses are placeholders: update them from your own CAD/BOM.
  -->
  <compiler angle="radian" coordinate="local" inertiafromgeom="true"/>
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>

  <default>
    <joint type="hinge" axis="0 1 0" limited="true" range="-1.55 1.55"
           damping="0.05" armature="0.01" frictionloss="0.01"/>
    <geom contype="1" conaffinity="1" condim="3"
          friction="0.9 0.02 0.001" rgba="0.6 0.6 0.6 1"/>
    <position kp="2.0" kv="0.1" ctrllimited="true" ctrlrange="-1.55 1.55"
              forcelimited="true" forcerange="-0.30 0.30"/>
  </default>

  <worldbody>
    <geom name="floor" type="plane" size="3 3 0.1"
          rgba="0.18 0.18 0.22 1" friction="1.0 0.005 0.0001"/>

    <body name="body" pos="0 0 0.20">
      <freejoint name="root"/>
      <geom name="body_geom" type="box" size="0.05 0.035 0.05"
            mass="0.35" rgba="0.20 0.50 0.80 1"/>
      <site name="imu" pos="0 0 0.05" size="0.005"/>

      <body name="link1" pos="0 0 -0.03">
        <joint name="shoulder"/>
        <geom name="link1_geom" type="capsule" fromto="0 0 0 0 0 -0.07"
              size="0.008" mass="0.04" rgba="0.85 0.45 0.20 1"/>

        <body name="link2" pos="0 0 -0.07">
          <joint name="elbow"/>
          <geom name="link2_geom" type="capsule" fromto="0 0 0 0 0 -0.06"
                size="0.008" mass="0.03" rgba="0.85 0.20 0.20 1"/>
          <geom name="foot" type="sphere" pos="0 0 -0.07" size="0.015"
                mass="0.02" rgba="0.95 0.75 0.10 1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="shoulder_act" joint="shoulder"/>
    <position name="elbow_act" joint="elbow"/>
  </actuator>

  <sensor>
    <framequat name="body_quat" objtype="body" objname="body"/>
    <gyro name="body_gyro" site="imu"/>
    <accelerometer name="body_acc" site="imu"/>
    <jointpos name="shoulder_q" joint="shoulder"/>
    <jointpos name="elbow_q" joint="elbow"/>
    <jointvel name="shoulder_dq" joint="shoulder"/>
    <jointvel name="elbow_dq" joint="elbow"/>
  </sensor>

  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>
</mujoco>
